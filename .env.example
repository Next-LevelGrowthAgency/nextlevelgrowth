# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.nextlevelgrowth.com

# ── Growth Audit form (choose ONE delivery method and fill it in) ──────
# Email notifications (e.g. Resend, Postmark, SendGrid)
EMAIL_PROVIDER_API_KEY=
EMAIL_TO_ADDRESS=hello@nextlevelgrowth.com
EMAIL_FROM_ADDRESS=noreply@nextlevelgrowth.com

# CRM integration (e.g. HubSpot, Pipedrive, Airtable)
CRM_API_KEY=
CRM_ENDPOINT_URL=

# ── Spam protection ─────────────────────────────────────────────────────
# e.g. Cloudflare Turnstile or hCaptcha site/secret keys
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── AI Chat (optional — leave blank to keep the chat widget disabled) ──
NEXT_PUBLIC_CHAT_ENABLED=false
AI_CHAT_PROVIDER_API_KEY=

# ── Analytics ────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
