# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.nextlevelgrowth.com

# ── Growth Audit form (choose ONE delivery method and fill it in) ──────
# Email notifications (e.g. Resend, Postmark, SendGrid)
EMAIL_PROVIDER_API_KEY=
EMAIL_TO_ADDRESS=hello@nextlevelgrowth.com
EMAIL_FROM_ADDRESS=noreply@nextlevelgrowth.com

# CRM integration (e.g. HubSpot, Pipedrive, Airtable)
CRM_API_KEY=
CRM_ENDPOINT_URL=

# ── Spam protection ─────────────────────────────────────────────────────
# e.g. Cloudflare Turnstile or hCaptcha site/secret keys
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── AI Chat (optional — leave blank to keep the chat widget disabled) ──
NEXT_PUBLIC_CHAT_ENABLED=false
AI_CHAT_PROVIDER_API_KEY=

# ── Analytics ────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Growth Coach owner dashboard (DEVELOPMENT-ONLY AUTH — see production
# recommendation before ever deploying this) ────────────────────────────
# A single shared dev password gating /admin/*, hashed with scrypt — never
# store the plaintext password itself, only the hash below. Generate one
# locally (see src/lib/growth-coach/auth/session.ts) and set it in your own
# .env.local, never here or in source control. Leave blank to keep /admin
# inaccessible.
GROWTH_COACH_ADMIN_DEV_PASSWORD_HASH=
GROWTH_COACH_SESSION_SECRET=
